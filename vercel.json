{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "outputDirectory": "out/renderer"
    },
    "blog": {
      "root": "blog",
      "framework": "eleventy",
      "outputDirectory": "_site"
    }
  },
  "rewrites": [
    {
      "source": "/blog/(.*)",
      "destination": {
        "service": "blog"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
