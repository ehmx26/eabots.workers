{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "blog": {
      "root": "blog",
      "framework": "eleventy"
    }
  },
  "rewrites": [
    {
      "source": "/blog/(.*)",
      "destination": {
        "service": "blog"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
